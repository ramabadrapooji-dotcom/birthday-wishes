/*
  # Prevent your site from being embedded inside iframes on other sites (clickjacking)
  X-Frame-Options: DENY
  
  # Stop browsers from sniffing MIME types (type-confusion attacks)
  X-Content-Type-Options: nosniff
  
  # Don't send referrer info when navigating away
  Referrer-Policy: no-referrer
  
  # Force HTTPS for 1 year
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Block access to source maps in production (hides your code logic)
  X-Source-Map: none

  # Permissions Policy - disable unused browser features
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
